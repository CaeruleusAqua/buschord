bin/
obj/
*.user
*.log
sample/
sample2/
schema/
ui_screenshot*.png

# Manufacturer catalogue data and vendor binaries stay local; never commit them.
*.knxprod
*.knxprod.zip
*.vd4
*.vd5
sample-catalogs/
catalogs/
catalogue-library/
artifacts/

# Project archives can contain installation data; checks generate their own fixtures.
*.knxproj

# Machine-local protection settings belong outside the checkout.
archive-protection*.json

# Release signing material stays outside the checkout; public anchors are source.
*.pfx
*.p12
*.key
*-private.pem
*.private.pem
*-private.asc
*.private.asc

# Python checks do not add interpreter caches to source control.
__pycache__/
*.py[cod]
