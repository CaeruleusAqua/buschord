<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Referenced development builds use dotnet exec; a self-contained publish needs its native host. -->
    <UseAppHost Condition="'$(SelfContained)' != 'true'">false</UseAppHost>
    <UseAppHost Condition="'$(SelfContained)' == 'true'">true</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Knx.Core\Knx.Core.csproj" />
    <PackageReference Include="Jint" Version="4.17.0" />
  </ItemGroup>
</Project>
