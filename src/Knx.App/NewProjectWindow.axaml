<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Knx.App.Localization"
        x:Class="Knx.App.NewProjectWindow"
        Title="{loc:Tr NewProjectTitle}" Width="560" Height="440" MinWidth="460" MinHeight="380">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,12,0,0">
      <Button Content="{loc:Tr BtnCreate}" Click="OnCreate" IsDefault="True" />
      <Button Content="{loc:Tr BtnCancel}" Click="OnCancel" />
    </StackPanel>

    <StackPanel Spacing="10">
      <TextBlock Text="{loc:Tr NewProjectHeader}" FontWeight="SemiBold" />
      <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr ColName}" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Text="{loc:Tr NewProjectTitle}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr NewProjectComment}" VerticalAlignment="Center" Margin="0,8,0,0" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="CommentBox" Margin="0,8,0,0" />
      </Grid>

      <TextBlock Text="{loc:Tr NewProjectTopology}" FontWeight="SemiBold" Margin="0,6,0,0" />
      <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr NewProjectStyle}" VerticalAlignment="Center" />
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="StyleBox" SelectedIndex="0" HorizontalAlignment="Left" Width="220">
          <ComboBoxItem Content="{loc:Tr NewProjectStyleThree}" />
          <ComboBoxItem Content="{loc:Tr NewProjectStyleTwo}" />
          <ComboBoxItem Content="{loc:Tr NewProjectStyleFree}" />
        </ComboBox>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr NewProjectAreas}" VerticalAlignment="Center" Margin="0,8,0,0" />
        <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="AreasBox" Minimum="1" Maximum="15" Value="1"
                       HorizontalAlignment="Left" Width="120" Margin="0,8,0,0" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr NewProjectLines}" VerticalAlignment="Center" Margin="0,8,0,0" />
        <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="LinesBox" Minimum="1" Maximum="15" Value="1"
                       HorizontalAlignment="Left" Width="120" Margin="0,8,0,0" />
      </Grid>
    </StackPanel>
  </DockPanel>
</Window>
