<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Knx.App.Views"
             xmlns:loc="using:Knx.App.Localization"
             x:Class="Knx.App.Views.ParameterPane">
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="{StaticResource ControlGap}" Margin="0,12,0,0">
      <Button x:Name="ReviewButton" Content="Review changes" Click="OnReview" IsVisible="False" />
      <Button x:Name="ApplyButton" Content="{loc:Tr BtnApply}" Click="OnApply" IsVisible="False"
              Classes="primary" />
      <Button x:Name="CloseButton" Content="{loc:Tr BtnClose}" Click="OnClose" IsVisible="False" />
    </StackPanel>
    <TextBlock x:Name="MessageText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0" />
    <StackPanel x:Name="PreviewPanel" DockPanel.Dock="Bottom" IsVisible="False" Spacing="8" Margin="0,12,0,0">
      <TextBlock x:Name="PreviewSummary" FontWeight="Bold" />
      <ScrollViewer MaxHeight="180">
        <ItemsControl x:Name="PreviewList">
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Description}" TextWrapping="Wrap" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="PreviewLimitations" TextWrapping="Wrap" Classes="muted" />
      <Button x:Name="CancelReviewButton" Content="Cancel review" Click="OnCancelReview" />
    </StackPanel>
    <Expander x:Name="NoticeExpander" DockPanel.Dock="Top" Padding="0" Margin="0,0,0,8"
              HorizontalAlignment="Stretch">
      <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{loc:Tr ParameterNoticeShort}" VerticalAlignment="Center" />
          <TextBlock Text="?" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Tr ParameterStaticNotice}" TextWrapping="Wrap" />
        <TextBlock x:Name="WarningDetail" IsVisible="False" TextWrapping="Wrap" Classes="muted" />
      </StackPanel>
    </Expander>
    <TextBlock x:Name="WarningText" DockPanel.Dock="Top" IsVisible="False" TextWrapping="Wrap"
               Text="{loc:Tr ParameterNoticeMore}" Classes="muted" Margin="0,0,0,12" />
    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" IsVisible="False" TextWrapping="Wrap"
               Classes="muted" Margin="0,0,0,8" />
    <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontWeight="Bold" FontSize="14"
               Margin="0,0,0,8" Text="{loc:Tr ParameterTitle}" TextWrapping="Wrap" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="ParameterList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="220,*" Margin="0,3" IsVisible="{Binding IsVisible}">
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Description}" Classes="muted"
                           TextWrapping="Wrap" IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
              <ContentControl Grid.Column="1" Content="{Binding}"
                              ContentTemplate="{x:Static views:SessionParameterTemplate.Instance}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
