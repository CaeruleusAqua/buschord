<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Knx.App.Views"
             xmlns:loc="using:Knx.App.Localization"
             x:Class="Knx.App.Views.ParameterPane">
  <DockPanel LastChildFill="True" Margin="0">
    <!-- Sticky V4 footer: draft indicator and validation summary on the left, actions on the right. -->
    <Border x:Name="Footer" DockPanel.Dock="Bottom" Background="{DynamicResource WbPaper}"
            BorderBrush="{DynamicResource WbLine}" BorderThickness="0,1,0,0" Padding="0,10,0,2" Margin="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border x:Name="DraftPill" Background="{DynamicResource WbTint}" CornerRadius="9"
                  Padding="9,3" IsVisible="False" VerticalAlignment="Center">
            <TextBlock x:Name="DraftText" FontSize="10.5" FontWeight="Medium"
                       Foreground="{DynamicResource WbSelectedText}" />
          </Border>
          <TextBlock x:Name="ValidationSummary" Classes="wb-error" FontSize="11" TextWrapping="Wrap"
                     VerticalAlignment="Center" IsVisible="False" />
          <TextBlock x:Name="StatusHint" Classes="wb-muted" VerticalAlignment="Center" IsVisible="False" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="ResetButton" Classes="wb-button" Click="OnReset" IsVisible="False" />
          <Button x:Name="DiscardButton" Classes="wb-button" Click="OnDiscard" IsVisible="False" />
          <Button x:Name="ReviewButton" Click="OnReview" IsVisible="False" Classes="wb-button" />
          <Button x:Name="ApplyButton" Content="{loc:Tr BtnApply}" Click="OnApply" IsVisible="False"
                  Classes="wb-button wb-primary" />
          <Button x:Name="CloseButton" Content="{loc:Tr BtnClose}" Click="OnClose" IsVisible="False"
                  Classes="wb-button" />
        </StackPanel>
        <TextBlock x:Name="MessageText" Grid.Row="1" Grid.ColumnSpan="2" TextWrapping="Wrap"
                   Classes="wb-muted" Margin="0,6,0,0" />
      </Grid>
    </Border>
    <StackPanel x:Name="PreviewPanel" DockPanel.Dock="Bottom" IsVisible="False" Spacing="8" Margin="0,12,0,0">
      <TextBlock x:Name="PreviewSummary" FontWeight="SemiBold" />
      <ScrollViewer MaxHeight="180">
        <ItemsControl x:Name="PreviewList">
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Description}" TextWrapping="Wrap" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="PreviewLimitations" TextWrapping="Wrap" Classes="wb-muted" />
      <Button x:Name="CancelReviewButton" Content="Cancel review" Click="OnCancelReview" Classes="wb-button" />
    </StackPanel>
    <Border x:Name="NoticePanel" DockPanel.Dock="Top" Classes="wb-panel" CornerRadius="6"
            BorderThickness="1" Padding="10,7" Margin="0,0,0,10" IsVisible="False">
      <StackPanel Spacing="2">
        <TextBlock Text="{loc:Tr ParameterNoticeShort}" FontWeight="SemiBold" FontSize="11" />
        <TextBlock Text="{loc:Tr ParameterStaticNotice}" TextWrapping="Wrap" Classes="wb-muted" />
        <TextBlock x:Name="WarningDetail" IsVisible="False" TextWrapping="Wrap" Classes="wb-warning" />
      </StackPanel>
    </Border>
    <TextBlock x:Name="WarningText" DockPanel.Dock="Top" IsVisible="False" TextWrapping="Wrap"
               Text="{loc:Tr ParameterNoticeMore}" Classes="wb-muted" Margin="0,0,0,10" />
    <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" IsVisible="False" TextWrapping="Wrap"
               Classes="wb-muted" Margin="0,0,0,8" />
    <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" Classes="wb-heading"
               Margin="0,0,0,6" Text="{loc:Tr ParameterTitle}" TextWrapping="Wrap" />
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,2,2,0">
      <ItemsControl x:Name="ParameterList" HorizontalAlignment="Stretch">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- One field column, capped at the reference's 540 px; label above its editor. -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" HorizontalAlignment="Left"
                  Width="{Binding $parent[ScrollViewer].Bounds.Width, Converter={x:Static views:ParameterFieldWidthConverter.Instance}}"
                  Margin="0,0,0,14" IsVisible="{Binding IsVisible}">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" Text="{Binding Description}" Classes="wb-muted" TextWrapping="Wrap"
                         IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ContentControl Grid.Row="2" Content="{Binding}" Margin="0,4,0,0"
                              HorizontalAlignment="Stretch"
                              ContentTemplate="{x:Static views:SessionParameterTemplate.Instance}" />
              <TextBlock Grid.Row="3" Classes="wb-error" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"
                         IsVisible="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock.Text>
                  <MultiBinding Converter="{x:Static views:ParameterFieldErrorConverter.Instance}">
                    <Binding />
                    <Binding Path="Value" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
