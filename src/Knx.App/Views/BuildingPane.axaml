<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Knx.App.Localization"
             xmlns:views="using:Knx.App.Views"
             x:Class="Knx.App.Views.BuildingPane">
  <Grid>
    <TextBlock x:Name="EmptyProject" Classes="muted" Text="{loc:Tr UxNeedsProject}"
               TextWrapping="Wrap" Margin="12" IsVisible="False" />

    <Grid x:Name="Body" RowDefinitions="Auto,Auto,*,Auto" Margin="8" IsVisible="False">
      <StackPanel Grid.Row="0" Spacing="3">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <views:Icon Symbol="AccountTree" VerticalAlignment="Center" />
          <TextBlock Text="{loc:Tr BuildingTitle}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Text="{loc:Tr LinkOfflineNotice}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <WrapPanel Grid.Row="1" Margin="0,8">
        <TextBlock Text="{loc:Tr BuildingKind}" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,4" />
        <ComboBox x:Name="KindBox" Width="150" Margin="0,0,6,4">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox x:Name="NameBox" Width="190" Margin="0,0,6,4" Watermark="{loc:Tr BuildingNewSpace}" />
        <Button x:Name="AddButton" Click="OnAdd" Margin="0,0,6,4" ToolTip.Tip="{loc:Tr BuildingAdd}">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <views:Icon Symbol="NoteAdd" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Tr BuildingAdd}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="RenameButton" Content="{loc:Tr BuildingRename}" Click="OnRename" Margin="0,0,6,4" />
        <Button x:Name="DeleteButton" Content="{loc:Tr BuildingDelete}" Click="OnDelete" Margin="0,0,6,4" />
      </WrapPanel>

      <Grid Grid.Row="2" ColumnDefinitions="2*,8,3*">
        <Border Grid.Column="0" Classes="panel">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="panelHeader" Text="{loc:Tr BuildingSpaces}" />
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="6"
                     Watermark="{loc:Tr BuildingSearch}" TextChanged="OnSearchChanged" />
            <Grid>
              <TreeView x:Name="Tree" SelectionChanged="OnSpaceSelected">
                <TreeView.Styles>
                  <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                  </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,1">
                      <views:Icon Symbol="FolderOpen" Width="16" Height="16" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding KindText}" Classes="muted" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding CountText}" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
              <StackPanel x:Name="SpacesEmpty" Spacing="8" Margin="16"
                          HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False">
                <TextBlock Text="{loc:Tr BuildingNoSpaces}" Classes="muted"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="{loc:Tr BuildingAdd}" HorizontalAlignment="Center" Click="OnAdd" />
              </StackPanel>
            </Grid>
          </DockPanel>
        </Border>

        <Grid Grid.Column="2" RowDefinitions="3*,Auto,2*">
          <Border Grid.Row="0" Classes="panel">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="panelHeader" Text="{loc:Tr BuildingDevicesInSpace}" />
              <Grid>
                <ListBox x:Name="SpaceDevices" SelectionChanged="OnSpaceDeviceSelected">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="80,*" Margin="6,1">
                        <TextBlock Grid.Column="0" Text="{Binding AddressText}" Classes="mono" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="SpaceDeviceEmpty" Classes="muted" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
              </Grid>
            </DockPanel>
          </Border>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8">
            <Button x:Name="AssignButton" Click="OnAssign">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <views:Icon Symbol="Link" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Tr BuildingAssign}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button x:Name="UnassignButton" Content="{loc:Tr BuildingUnassign}" Click="OnUnassign" />
          </StackPanel>

          <Border Grid.Row="2" Classes="panel">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Classes="panelHeader" Text="{loc:Tr BuildingUnassigned}" />
              <Grid>
                <ListBox x:Name="FreeDevices" SelectionChanged="OnFreeDeviceSelected">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="80,*" Margin="6,1">
                        <TextBlock Grid.Column="0" Text="{Binding AddressText}" Classes="mono" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="FreeDeviceEmpty" Classes="muted" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
              </Grid>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>

      <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</UserControl>
