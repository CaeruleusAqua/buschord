<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Knx.App.Views"
             xmlns:loc="using:Knx.App.Localization"
             x:Class="Knx.App.Views.GroupMonitorPane">
  <UserControl.Styles>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,*,130,Auto" Margin="0,0,0,8">
      <Button Grid.Column="0" x:Name="PauseButton" Classes="secondary" Click="OnPause">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <views:Icon x:Name="PauseIcon" Symbol="Stop" Width="14" Height="14" VerticalAlignment="Center" />
          <TextBlock x:Name="PauseText" Text="{loc:Tr BtnStop}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" x:Name="ClearButton" Classes="secondary" Content="{loc:Tr BtnClearMonitor}"
              Click="OnClear" Margin="6,0,0,0" />
      <Button Grid.Column="2" x:Name="ExportButton" Classes="secondary" Content="{loc:Tr BtnSaveCsvDots}"
              Click="OnExport" Margin="6,0,0,0" />
      <Grid Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center">
        <TextBox x:Name="FilterBox" Watermark="{loc:Tr CatalogSearch}" TextChanged="OnTextChanged"
                 Padding="28,4,6,4" />
        <views:Icon Symbol="Search" Width="14" Height="14" Margin="8,0,0,0" HorizontalAlignment="Left"
                    VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource EtsMuted}" />
      </Grid>
      <ComboBox Grid.Column="4" x:Name="KindBox" SelectedIndex="0" SelectionChanged="OnKindChanged"
                HorizontalAlignment="Stretch" Margin="8,0,0,0" />
      <CheckBox Grid.Column="5" x:Name="GroupOnlyBox" Content="{loc:Tr LblGroupOnly}" Margin="10,0,0,0"
                VerticalAlignment="Center" Checked="OnGroupOnlyChanged" Unchecked="OnGroupOnlyChanged" />
    </Grid>

    <TextBlock DockPanel.Dock="Top" x:Name="CountText" Classes="muted" Margin="0,0,0,6" />
    <TextBlock DockPanel.Dock="Top" x:Name="MessageText" IsVisible="False" TextWrapping="Wrap"
               Foreground="{DynamicResource EtsError}" Margin="0,0,0,6" />

    <Border DockPanel.Dock="Top" Background="{DynamicResource EtsHeaderRow}" Padding="8,4"
            BorderBrush="{DynamicResource EtsBorder}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="92,88,92,86,*,100,*">
        <TextBlock Grid.Column="0" Classes="columnHeader" Text="{loc:Tr ColTime}" />
        <TextBlock Grid.Column="1" Classes="columnHeader" Text="{loc:Tr ColSource}" />
        <TextBlock Grid.Column="2" Classes="columnHeader" Text="{loc:Tr ColAddress}" />
        <TextBlock Grid.Column="3" Classes="columnHeader" Text="{loc:Tr ColType}" />
        <TextBlock Grid.Column="4" Classes="columnHeader" Text="{loc:Tr ColValue}" />
        <TextBlock Grid.Column="5" Classes="columnHeader" Text="{loc:Tr ColDatapointType}" />
        <TextBlock Grid.Column="6" Classes="columnHeader" Text="{loc:Tr ColName}" />
      </Grid>
    </Border>

    <Grid>
      <ListBox x:Name="EntryList" BorderThickness="0" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="92,88,92,86,*,100,*" Margin="8,1">
              <TextBlock Grid.Column="0" Text="{Binding TimeText}" Classes="mono" />
              <TextBlock Grid.Column="1" Text="{Binding Source}" Classes="mono" />
              <TextBlock Grid.Column="2" Text="{Binding Destination}" Classes="mono" />
              <TextBlock Grid.Column="3" Text="{Binding KindText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="4" Text="{Binding ValueText}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="5" Text="{Binding DatapointType}" Classes="mono"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="6" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="EmptyState" IsVisible="False" Spacing="8" Margin="24"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:Icon Symbol="Cable" Width="32" Height="32" HorizontalAlignment="Center"
                    Foreground="{DynamicResource EtsMuted}" />
        <TextBlock x:Name="EmptyText" Classes="muted" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
