<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Knx.App.Localization"
             xmlns:views="using:Knx.App.Views"
             x:Class="Knx.App.Views.CatalogPane"
             Classes="wb-root" Background="{DynamicResource WbPaper}">
  <!-- Opt-in V4 styling: the legacy MainWindow still renders the same pane with Wb tokens. -->
  <UserControl.Styles>
    <Style Selector="TextBlock.catalog-section">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WbText}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.catalog-caption">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource WbMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.catalog-meta">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource WbMuted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ListBox.catalog-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.catalog-list ListBoxItem">
      <Setter Property="MinHeight" Value="{DynamicResource WbRowHeight}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="{DynamicResource WbFontSizeSmall}" />
      <Setter Property="Foreground" Value="{DynamicResource WbText}" />
    </Style>
    <Style Selector="ListBox.catalog-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WbHover}" />
    </Style>
    <Style Selector="ListBox.catalog-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource WbSelected}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource WbSelectedText}" />
    </Style>
    <Style Selector="ListBox.catalog-list ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource WbSelectedText}" />
    </Style>
    <Style Selector="ListBox.catalog-list ListBoxItem:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource WbAccent}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="StackPanel.catalog-details TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource WbText}" />
    </Style>
    <Style Selector="StackPanel.catalog-details TextBlock.muted">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource WbMuted}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- One toolbar for actions, filtering and transient state. -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource WbLine}" BorderThickness="0,0,0,1"
            Padding="0,0,0,10" Margin="0,0,0,10">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <Grid ColumnDefinitions="*,200">
            <Grid>
              <TextBox x:Name="SearchBox" Classes="wb-field" Padding="30,3,8,3"
                       PlaceholderText="{loc:Tr CatalogSearch}" TextChanged="OnFilterChanged" />
              <views:Icon Symbol="Search" Width="14" Height="14" Margin="9,0,0,0"
                          HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                          Foreground="{DynamicResource WbMuted}" />
            </Grid>
            <ComboBox x:Name="SectionBox" Grid.Column="1" Classes="wb-field" Margin="8,0,0,0"
                      HorizontalAlignment="Stretch" SelectionChanged="OnSectionChanged" />
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
            <Button Classes="wb-button wb-compact" Content="{loc:Tr CatalogImport}" Click="OnImport" />
            <Button Classes="wb-button wb-compact" Content="{loc:Tr CatalogReload}" Click="OnReload" />
            <Button x:Name="CloseButton" Classes="wb-button wb-compact wb-quiet"
                    Content="{loc:Tr BtnClose}" Click="OnClose" />
          </StackPanel>
        </Grid>

        <TextBlock x:Name="ErrorText" Classes="wb-error" FontSize="11" TextTrimming="CharacterEllipsis"
                   IsVisible="False" />

        <StackPanel x:Name="LoadingState" Orientation="Horizontal" Spacing="10" IsVisible="False">
          <ProgressBar IsIndeterminate="True" Width="120" Height="3" VerticalAlignment="Center"
                       Foreground="{DynamicResource WbAccent}" Background="{DynamicResource WbHover}" />
          <TextBlock x:Name="LoadingText" Classes="wb-muted" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="200,*,290">
      <!-- Library -->
      <Border Grid.Column="0" Background="{DynamicResource WbPanel}"
              BorderBrush="{DynamicResource WbLine}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="40" Padding="12,0"
                  BorderBrush="{DynamicResource WbLine}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="LibraryHeader" Classes="catalog-section" />
          </Border>
          <Grid>
            <ListBox x:Name="CatalogList" Classes="catalog-list" SelectionChanged="OnCatalogChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Height="32" Margin="12,0">
                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                      <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} · {1}">
                          <Binding Path="Name" />
                          <Binding Path="Manufacturer.Name" />
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Classes="catalog-meta" Margin="6,0,0,0"
                               Text="{Binding Products.Count}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="LibraryEmpty" IsVisible="False" Spacing="8" Margin="16"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
              <views:Icon Symbol="LibraryBooks" Width="22" Height="22" HorizontalAlignment="Center"
                          Foreground="{DynamicResource WbMuted}" />
              <TextBlock Text="{loc:Tr CatalogNoCatalog}" Classes="wb-muted"
                         TextWrapping="Wrap" TextAlignment="Center" />
              <Button Classes="wb-button wb-compact" Content="{loc:Tr CatalogImport}" Click="OnImport"
                      HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <!-- Products -->
      <Border Grid.Column="1" Background="{DynamicResource WbPaper}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="40" Padding="12,0"
                  BorderBrush="{DynamicResource WbLine}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="ProductsHeader" Classes="catalog-section" />
          </Border>

          <Border DockPanel.Dock="Top" Height="31" Background="{DynamicResource WbTableHeader}"
                  BorderBrush="{DynamicResource WbLine}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,90,45" Margin="10,0">
              <TextBlock Classes="catalog-caption" Text="{loc:Tr ColName}" />
              <TextBlock Grid.Column="1" Classes="catalog-caption" Text="{loc:Tr CatalogOrderNumber}" />
              <TextBlock Grid.Column="2" Classes="catalog-caption" Text="{loc:Tr CatalogProgramCount}" />
            </Grid>
          </Border>

          <Grid>
            <ListBox x:Name="ProductList" Classes="catalog-list" SelectionChanged="OnProductChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,90,45" Height="32" Margin="10,0">
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding OrderNumber}" Classes="wb-mono"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,6,0"
                               ToolTip.Tip="{Binding OrderNumber}" />
                    <TextBlock Grid.Column="2" Text="{Binding ProgramRefIds.Count}" Classes="catalog-meta" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="ProductsEmpty" IsVisible="False" Spacing="8" Margin="16"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
              <views:Icon Symbol="Search" Width="22" Height="22" HorizontalAlignment="Center"
                          Foreground="{DynamicResource WbMuted}" />
              <TextBlock x:Name="ProductsEmptyText" Classes="wb-muted" TextWrapping="Wrap"
                         TextAlignment="Center" MaxWidth="320" />
              <Button x:Name="ClearSearchButton" Classes="wb-button wb-compact"
                      Content="{loc:Tr CatalogNoResults}" Click="OnClearSearch" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <!-- Selection and insert target -->
      <Border Grid.Column="2" Background="{DynamicResource WbPanel}"
              BorderBrush="{DynamicResource WbLine}" BorderThickness="1,0,0,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Height="40" Padding="14,0"
                  BorderBrush="{DynamicResource WbLine}" BorderThickness="0,0,0,1">
            <TextBlock x:Name="UxInsert" Classes="catalog-section" Text="{loc:Tr UxInsert}" />
          </Border>

          <Border DockPanel.Dock="Bottom" Background="{DynamicResource WbPaper}"
                  BorderBrush="{DynamicResource WbLine}" BorderThickness="0,1,0,0" Padding="14,10">
            <StackPanel Spacing="8">
              <TextBlock x:Name="UxNeedsProject" Classes="wb-warning" FontSize="11"
                         Text="{loc:Tr UxNeedsProject}" TextWrapping="Wrap" IsVisible="False" />
              <StackPanel Spacing="4">
                <TextBlock Classes="catalog-caption" Text="{loc:Tr CatalogTargetLine}" />
                <ComboBox x:Name="LineBox" Classes="wb-field" HorizontalAlignment="Stretch"
                          SelectionChanged="OnLineChanged"
                          ToolTip.Tip="{Binding SelectedItem.Text, RelativeSource={RelativeSource Self}}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Classes="catalog-caption" Text="{loc:Tr ColAddress}" />
                <TextBox x:Name="AddressBox" Classes="wb-field" PlaceholderText="1.1.1"
                         TextChanged="OnAddressChanged" />
              </StackPanel>
              <StackPanel Spacing="4">
                <TextBlock Classes="catalog-caption" Text="{loc:Tr ColName}" />
                <TextBox x:Name="NameBox" Classes="wb-field" />
              </StackPanel>
              <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                <TextBlock x:Name="InsertStatus" FontSize="11" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button x:Name="InsertButton" Grid.Column="1" Classes="wb-button wb-primary"
                        Content="{loc:Tr UxInsert}" Click="OnInsert" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>
          </Border>

          <Grid>
            <ScrollViewer>
              <StackPanel Margin="14,12" Spacing="10">
                <TextBlock x:Name="UxProduct" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel x:Name="Details" Classes="catalog-details" Spacing="6" />
              </StackPanel>
            </ScrollViewer>
            <StackPanel x:Name="DetailsEmpty" Spacing="8" Margin="16"
                        VerticalAlignment="Center" HorizontalAlignment="Center">
              <views:Icon Symbol="LibraryBooks" Width="22" Height="22" HorizontalAlignment="Center"
                          Foreground="{DynamicResource WbMuted}" />
              <TextBlock Text="{loc:Tr CatalogNeedProduct}" Classes="wb-muted"
                         TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
