<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Knx.App.Views"
             xmlns:loc="using:Knx.App.Localization"
             x:Class="Knx.App.Views.BusMonitorPane">
  <UserControl.Styles>
    <Style Selector="Button.secondary">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,8">
      <Button Grid.Column="0" x:Name="PauseButton" Classes="secondary" Click="OnPause">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <views:Icon x:Name="PauseIcon" Symbol="Stop" Width="14" Height="14" VerticalAlignment="Center" />
          <TextBlock x:Name="PauseText" Text="{loc:Tr BtnStop}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Grid.Column="1" x:Name="ClearButton" Classes="secondary" Content="{loc:Tr BtnClearMonitor}"
              Click="OnClear" Margin="6,0,0,0" />
      <Button Grid.Column="2" x:Name="SaveButton" Classes="secondary" Content="{loc:Tr BtnSaveDots}"
              Click="OnSaveRecording" Margin="6,0,0,0" HorizontalAlignment="Right" />
    </Grid>

    <TextBlock DockPanel.Dock="Top" x:Name="CountText" Classes="muted" Margin="0,0,0,6" />

    <Grid>
      <ListBox x:Name="EntryList" BorderThickness="0" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding RawLine}" Classes="mono" TextWrapping="NoWrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel x:Name="EmptyState" IsVisible="False" Spacing="8" Margin="24"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
        <views:Icon Symbol="FormatListBulleted" Width="32" Height="32" HorizontalAlignment="Center"
                    Foreground="{DynamicResource EtsMuted}" />
        <TextBlock Text="{loc:Tr UxEmptyFindings}" Classes="muted" TextAlignment="Center" />
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
