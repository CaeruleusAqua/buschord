<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Knx.App.Localization" xmlns:views="using:Knx.App.Views"
        x:Class="Knx.App.Views.HelpWindow"
        Width="620" Height="640" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WbPaper}" Foreground="{DynamicResource WbText}"
        FontFamily="Inter, Segoe UI" FontSize="12">
  <Window.Styles>
    <Style Selector="TextBlock.help-heading">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource WbSelectedText}"/>
    </Style>
    <Style Selector="TextBlock.help-text">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource WbText}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Margin="24,22,24,12" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <views:ConceptIcon Symbol="help" Width="24" Height="24" VerticalAlignment="Center"/>
        <TextBlock Text="{loc:Wb HelpTip}" Classes="wb-heading" VerticalAlignment="Center"/>
      </StackPanel>
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Sections" Margin="24,4,24,20" Spacing="18"/>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{DynamicResource WbPanel}" BorderBrush="{DynamicResource WbLine}"
            BorderThickness="0,1,0,0" Padding="16,10">
      <Button x:Name="CloseButton" Classes="wb-button wb-primary" HorizontalAlignment="Right" MinWidth="110"/>
    </Border>
  </Grid>
</Window>
