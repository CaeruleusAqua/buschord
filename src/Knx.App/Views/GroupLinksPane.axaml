<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Knx.App.Localization"
             x:Class="Knx.App.Views.GroupLinksPane">
  <Grid>
    <TextBlock x:Name="EmptyText" Classes="muted" Text="{loc:Tr LinkSelectDevice}"
               TextWrapping="Wrap" Margin="12" IsVisible="False" />

    <Grid x:Name="Body" RowDefinitions="Auto,3*,2*,Auto">
      <StackPanel Grid.Row="0" Spacing="3">
        <TextBlock x:Name="DeviceText" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{loc:Tr LinkOfflineNotice}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>

      <Grid Grid.Row="1" ColumnDefinitions="*,8,*" Margin="0,8,0,0">
        <Border Grid.Column="0" Classes="panel">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="panelHeader" Text="{loc:Tr CommunicationObjects}" />
            <TextBox x:Name="ObjectSearch" DockPanel.Dock="Top" Margin="6"
                     Watermark="{loc:Tr ColName}" TextChanged="OnObjectFilterChanged" />
            <Grid>
              <ListBox x:Name="ObjectList" SelectionChanged="OnObjectSelected">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="34,*,90" Margin="6,1">
                      <TextBlock Grid.Column="0" Text="{Binding Number}" Classes="mono" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding DatapointType}" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="ObjectEmpty" Classes="muted" Text="{loc:Tr CatalogNoResults}"
                         TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
            </Grid>
          </DockPanel>
        </Border>

        <Border Grid.Column="2" Classes="panel">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="panelHeader" Text="{loc:Tr TabGroupAddresses}" />
            <TextBox x:Name="AddressSearch" DockPanel.Dock="Top" Margin="6"
                     Watermark="{loc:Tr ColAddress}" TextChanged="OnAddressFilterChanged" />
            <StackPanel DockPanel.Dock="Bottom" Margin="6">
              <Button x:Name="AddButton" Content="{loc:Tr LinkAdd}" HorizontalAlignment="Stretch"
                      Click="OnAdd" />
            </StackPanel>
            <Grid>
              <ListBox x:Name="AddressList" SelectionChanged="OnAddressSelected">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="80,*,80" Margin="6,1">
                      <TextBlock Grid.Column="0" Text="{Binding AddressText}" Classes="mono" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding DatapointType}" Classes="muted" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock x:Name="AddressEmpty" Classes="muted" Text="{loc:Tr CatalogNoResults}"
                         TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                         HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
            </Grid>
          </DockPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2" Classes="panel" Margin="0,8,0,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="panelHeader" Text="{loc:Tr LinkExisting}" />
          <StackPanel DockPanel.Dock="Bottom" Margin="6">
            <Button x:Name="RemoveButton" Content="{loc:Tr LinkRemove}" HorizontalAlignment="Stretch"
                    Click="OnRemove" />
          </StackPanel>
          <ListBox x:Name="LinkList" SelectionChanged="OnLinkSelected">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="90,*" Margin="6,1">
                  <TextBlock Grid.Column="0" Text="{Binding Address}" Classes="mono" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
  </Grid>
</UserControl>
