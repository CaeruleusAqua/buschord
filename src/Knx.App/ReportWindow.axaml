<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Knx.App.Localization"
        x:Class="Knx.App.ReportWindow"
        Width="900" Height="620" MinWidth="600" MinHeight="360"
        Title="{Binding Title}" Icon="/Assets/brand/buschord-house-transparent-tile-256.png">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,10">
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" />
      <TextBlock x:Name="SubtitleText" Classes="muted" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="{StaticResource ControlGap}" Margin="0,10,0,0">
      <Button x:Name="PrimaryButton" Content="{loc:Tr BtnApply}" Classes="primary" Click="OnPrimary" IsVisible="False" />
      <Button Content="{loc:Tr BtnSaveCsvDots}" Click="OnSaveCsv" />
      <Button Content="{loc:Tr BtnClose}" Click="OnClose" />
    </StackPanel>

    <Border Classes="panel">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="90,220,*" Background="{DynamicResource EtsHeaderRow}">
          <TextBlock Grid.Column="0" Classes="columnHeader" Text="{loc:Tr ColSeverity}" />
          <TextBlock Grid.Column="1" Classes="columnHeader" Text="{loc:Tr ColPath}" />
          <TextBlock Grid.Column="2" Classes="columnHeader" Text="{loc:Tr ColMessage}" />
        </Grid>
        <ListBox x:Name="Rows">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="90,220,*" Margin="6,1">
                <TextBlock Grid.Column="0" Text="{Binding Severity}" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="mono" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
