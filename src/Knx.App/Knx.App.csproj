<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: no console window when the desktop app is launched. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\brand\buschord-house-transparent-tile.ico</ApplicationIcon>
    <AssemblyName>BusChord</AssemblyName>
    <Product>BusChord</Product>
    <Description>Open-source building automation engineering</Description>
    <Company>BusChord</Company>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only the runtime sizes are embedded; vector/source artwork stays in the repo. -->
    <AvaloniaResource Include="Assets\brand\buschord-house-transparent-tile.ico" />
    <AvaloniaResource Include="Assets\brand\buschord-house-transparent-tile-256.png" />
    <AvaloniaResource Include="Assets\brand\buschord-mark.png" />
    <None Include="Assets\brand\buschord-house-transparent-tile.svg" />
    <None Include="Assets\brand\buschord-house-transparent-tile-1024.png" />
    <None Include="Assets\brand\buschord-house-transparent-tile-preview.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.12" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- MIT docking: Dock 11.3.12.1 targets Avalonia 11.3.12; the model package brings
         Dock.Model 11.3.12.1 and Dock.Settings 11.3.12.1 along. -->
    <PackageReference Include="Dock.Avalonia" Version="11.3.12.1" />
    <!-- Dock 11.3 moved DockFluentTheme out of Dock.Avalonia into its own package. -->
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="11.3.12.1" />
    <PackageReference Include="Dock.Model" Version="11.3.12.1" />
    <PackageReference Include="Dock.Model.Mvvm" Version="11.3.12.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Knx.Core\Knx.Core.csproj" />
    <ProjectReference Include="..\Knx.Bus\Knx.Bus.csproj" />
    <ProjectReference Include="..\Knx.ProjectCompare\Knx.ProjectCompare.csproj" />
    <ProjectReference Include="..\Knx.Reports\Knx.Reports.csproj" />
  </ItemGroup>
</Project>
