<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: no console window when the desktop app is launched. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\brand\buschord-house-icon.ico</ApplicationIcon>
    <AssemblyName>BusChord</AssemblyName>
    <Product>BusChord</Product>
    <Description>Open-source building automation engineering</Description>
    <Company>BusChord</Company>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only the runtime sizes are embedded; vector/source artwork stays in the repo. -->
    <AvaloniaResource Include="Assets\brand\buschord-house-icon.ico" />
    <AvaloniaResource Include="Assets\brand\buschord-house-icon-256.png" />
    <None Include="Assets\brand\buschord-house-icon.svg" />
    <None Include="Assets\brand\buschord-house-icon-1024.png" />
    <None Include="Assets\brand\buschord-house-preview.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- MIT docking: Dock.Avalonia 11.2.0 matches Avalonia 11.2.0; the model package brings
         Dock.Model 11.2.0 and Dock.Settings 11.2.0 along. -->
    <PackageReference Include="Dock.Avalonia" Version="11.2.0" />
    <PackageReference Include="Dock.Model" Version="11.2.0" />
    <PackageReference Include="Dock.Model.Mvvm" Version="11.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Knx.Core\Knx.Core.csproj" />
    <ProjectReference Include="..\Knx.Bus\Knx.Bus.csproj" />
    <ProjectReference Include="..\Knx.ProjectCompare\Knx.ProjectCompare.csproj" />
    <ProjectReference Include="..\Knx.Reports\Knx.Reports.csproj" />
  </ItemGroup>
</Project>
