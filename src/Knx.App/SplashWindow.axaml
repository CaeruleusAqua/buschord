<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Knx.App.Localization"
        x:Class="Knx.App.SplashWindow"
        Width="380" Height="420" CanResize="False" ShowInTaskbar="False"
        SystemDecorations="None" TransparencyLevelHint="Transparent"
        Background="Transparent" WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="{DynamicResource WbFontFamily}" Foreground="{DynamicResource WbText}">
  <Border Background="{DynamicResource WbBackground}"
          CornerRadius="{DynamicResource WbDialogRadius}" Padding="28" ClipToBounds="True">
    <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image Source="/Assets/brand/buschord-mark.png" Width="240" Height="240" />
      <TextBlock Text="BusChord" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="{loc:Tr SplashTagline}" FontSize="11"
                 Foreground="{DynamicResource WbMuted}" HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</Window>
