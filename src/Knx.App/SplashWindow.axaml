<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Knx.App.SplashWindow"
        Width="380" Height="420" CanResize="False" ShowInTaskbar="False"
        SystemDecorations="None" TransparencyLevelHint="Transparent"
        Background="Transparent" WindowStartupLocation="CenterScreen" Topmost="True">
  <Border Background="{DynamicResource EtsChrome}" CornerRadius="18" Padding="28">
    <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image Source="/Assets/brand/buschord-mark.png" Width="240" Height="240" />
      <TextBlock Text="BusChord" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="Open-source building automation engineering" FontSize="11"
                 Foreground="{DynamicResource EtsMuted}" HorizontalAlignment="Center" />
    </StackPanel>
  </Border>
</Window>
