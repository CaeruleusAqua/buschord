<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Knx.App.Localization"
        x:Class="Knx.App.CompareWindow"
        Title="{loc:Tr TitleCompare}" Width="900" Height="640"
        Icon="/Assets/brand/buschord-house-transparent-tile-256.png">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <TextBlock x:Name="SummaryText" FontWeight="Bold" />
      <TextBlock x:Name="ProjectsText" Classes="muted" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="{StaticResource ControlGap}" Margin="0,12,0,0">
      <Button Content="{loc:Tr BtnSaveCsvDots}" Classes="primary" Click="OnExportCsv" />
      <Button Content="{loc:Tr BtnClose}" Click="OnClose" />
    </StackPanel>
    <Border Classes="panel">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="260,110,180,90,*" Background="{DynamicResource EtsHeaderRow}">
          <TextBlock Grid.Column="0" Classes="columnHeader" Text="{loc:Tr ColPath}" />
          <TextBlock Grid.Column="1" Classes="columnHeader" Text="{loc:Tr ColType}" />
          <TextBlock Grid.Column="2" Classes="columnHeader" Text="{loc:Tr ColName}" />
          <TextBlock Grid.Column="3" Classes="columnHeader" Text="{loc:Tr ColChange}" />
          <TextBlock Grid.Column="4" Classes="columnHeader" Text="{loc:Tr ColValue}" />
        </Grid>
        <ListBox x:Name="DiffGrid" IsVisible="True" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="260,110,180,90,*" Margin="6,1">
                <TextBlock Grid.Column="0" Text="{Binding Path}" Classes="mono" />
                <TextBlock Grid.Column="1" Text="{Binding ObjectType}" Classes="muted" />
                <TextBlock Grid.Column="2" Text="{Binding ObjectName}" Classes="muted" />
                <TextBlock Grid.Column="3" Text="{Binding Modification}" Classes="muted" FontWeight="Bold" />
                <TextBlock Grid.Column="4" Text="{Binding NewValue}" Classes="muted" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </DockPanel>
</Window>
