<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Knx.App.Localization"
        x:Class="Knx.App.CompareWindow"
        Classes="wb-dialog"
        Title="{loc:Tr TitleCompare}" Width="900" Height="640"
        Icon="/Assets/brand/buschord-house-transparent-tile-256.png">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Padding="22,20,22,10">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:Tr TitleCompare}" Classes="wb-title" />
        <TextBlock x:Name="SummaryText" Classes="wb-text" FontWeight="SemiBold" />
        <TextBlock x:Name="ProjectsText" Classes="wb-muted" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Classes="wb-dialog-surface" Margin="22,0,22,18">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource WbTableHeader}"
                BorderBrush="{DynamicResource WbLine}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="260,110,180,90,*">
            <TextBlock Grid.Column="0" Classes="wb-column-header" Text="{loc:Tr ColPath}" />
            <TextBlock Grid.Column="1" Classes="wb-column-header" Text="{loc:Tr ColType}" />
            <TextBlock Grid.Column="2" Classes="wb-column-header" Text="{loc:Tr ColName}" />
            <TextBlock Grid.Column="3" Classes="wb-column-header" Text="{loc:Tr ColChange}" />
            <TextBlock Grid.Column="4" Classes="wb-column-header" Text="{loc:Tr ColValue}" />
          </Grid>
        </Border>
        <ListBox x:Name="DiffGrid" Classes="wb-list">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="260,110,180,90,*">
                <TextBlock Grid.Column="0" Text="{Binding Path}" Classes="wb-mono" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ObjectType}" Classes="wb-muted" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding ObjectName}" Classes="wb-muted" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" Text="{Binding Modification}" Classes="wb-muted" FontWeight="SemiBold" />
                <TextBlock Grid.Column="4" Text="{Binding NewValue}" Classes="wb-muted" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Row="2" Classes="wb-dialog-footer">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="{loc:Tr BtnClose}" Classes="wb-button wb-quiet" Click="OnClose" IsCancel="True" />
        <Button Content="{loc:Tr BtnSaveCsvDots}" Classes="wb-button wb-primary" Click="OnExportCsv" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
