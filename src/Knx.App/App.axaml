<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Knx.App.Views"
             xmlns:sys="using:System"
             xmlns:fluent="using:Avalonia.Themes.Fluent"
             xmlns:dock="using:Dock.Model.Mvvm.Controls"
             x:Class="Knx.App.App">

  <!-- Dock documents and tools carry an existing control in Context; the host window of a
       floated panel resolves these templates through the application, not the main window. -->
  <Application.DataTemplates>
    <DataTemplate DataType="dock:Document" x:DataType="dock:Document">
      <ContentControl Content="{Binding Context}" />
    </DataTemplate>
    <DataTemplate DataType="dock:Tool" x:DataType="dock:Tool">
      <ContentControl Content="{Binding Context}" />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://BusChord/Assets/Icons.axaml" />
        <ResourceInclude Source="avares://BusChord/Assets/ConceptIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Control tokens: the single source of geometry for buttons, fields and cards.
           Variants change surface, border and text colour only; height, padding, radius and
           the focus ring stay identical so every control sits on the same baseline. -->
      <sys:Double x:Key="ControlHeight">30</sys:Double>
      <sys:Double x:Key="ControlHeightCompact">26</sys:Double>
      <Thickness x:Key="ControlPadding">10,5</Thickness>
      <Thickness x:Key="ControlPaddingCompact">8,4</Thickness>
      <CornerRadius x:Key="ControlRadius">4</CornerRadius>
      <sys:Double x:Key="ControlGap">6</sys:Double>
      <sys:Double x:Key="IconSize">16</sys:Double>
      <sys:Double x:Key="IconSizeRibbon">20</sys:Double>
      <sys:Double x:Key="IconSizeCard">32</sys:Double>
      <Thickness x:Key="FocusRing">2</Thickness>

      <ResourceDictionary.ThemeDictionaries>

        <!-- ===== light ===== -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="EtsChrome" Color="#EFF1F3" />
          <SolidColorBrush x:Key="EtsPanel" Color="#FFFFFF" />
          <SolidColorBrush x:Key="EtsBorder" Color="#BFC5CB" />
          <SolidColorBrush x:Key="EtsHeaderRow" Color="#E3E9EF" />
          <SolidColorBrush x:Key="EtsText" Color="#202C3C" />
          <SolidColorBrush x:Key="EtsMuted" Color="#4C5560" />
          <SolidColorBrush x:Key="EtsAccent" Color="#087E81" />
          <SolidColorBrush x:Key="EtsAccentHover" Color="#076C70" />
          <SolidColorBrush x:Key="EtsOnAccent" Color="#FFFFFF" />
          <SolidColorBrush x:Key="EtsAccentSoft" Color="#E4F2F1" />
          <SolidColorBrush x:Key="EtsButtonBackground" Color="#FBFCFD" />
          <SolidColorBrush x:Key="EtsButtonHover" Color="#E1EDF8" />
          <SolidColorBrush x:Key="EtsStatusBackground" Color="#E2E5E8" />
          <SolidColorBrush x:Key="EtsError" Color="#A31B12" />
          <SolidColorBrush x:Key="EtsWarning" Color="#7A5200" />
          <SolidColorBrush x:Key="EtsOk" Color="#14603A" />
          <SolidColorBrush x:Key="EtsDisabledBackground" Color="#EEF0F2" />
          <SolidColorBrush x:Key="EtsDisabledText" Color="#606A75" />

          <!-- Fluent disabled surfaces follow the palette instead of the theme's grey. -->
          <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#EEF0F2" />
          <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#BFC5CB" />
          <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#606A75" />
          <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#EEF0F2" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#BFC5CB" />
          <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#606A75" />

          <!-- Dock chrome mapped onto the Ets palette (light). -->
          <Color x:Key="RegionColor">#FFFFFF</Color>
          <SolidColorBrush x:Key="DockThemeBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="DockThemeBorderLowBrush" Color="#BFC5CB" />
          <SolidColorBrush x:Key="DockThemeForegroundBrush" Color="#14181C" />
          <SolidColorBrush x:Key="DockThemeAccentBrush" Color="#087E81" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushLow" Color="#087E81" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushMed" Color="#076C70" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushHigh" Color="#E4F2F1" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator" Color="#087E81" />
          <SolidColorBrush x:Key="DockApplicationAccentForegroundBrush" Color="#FFFFFF" />

          <!-- Tooltips are popup top-levels and do not inherit the window palette. -->
          <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToolTipForeground" Color="#202C3C" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#BFC5CB" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#202C3C" />
        </ResourceDictionary>

        <!-- ===== dark ===== -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="EtsChrome" Color="#1C1F23" />
          <SolidColorBrush x:Key="EtsPanel" Color="#25292E" />
          <SolidColorBrush x:Key="EtsBorder" Color="#4A5158" />
          <SolidColorBrush x:Key="EtsHeaderRow" Color="#2F353B" />
          <SolidColorBrush x:Key="EtsText" Color="#E5EBF3" />
          <SolidColorBrush x:Key="EtsMuted" Color="#B9C1C9" />
          <SolidColorBrush x:Key="EtsAccent" Color="#62D1CD" />
          <SolidColorBrush x:Key="EtsAccentHover" Color="#85E0DC" />
          <SolidColorBrush x:Key="EtsOnAccent" Color="#101418" />
          <SolidColorBrush x:Key="EtsAccentSoft" Color="#233F43" />
          <SolidColorBrush x:Key="EtsButtonBackground" Color="#33383E" />
          <SolidColorBrush x:Key="EtsButtonHover" Color="#3E4A56" />
          <SolidColorBrush x:Key="EtsStatusBackground" Color="#2A2E33" />
          <SolidColorBrush x:Key="EtsError" Color="#FF9A91" />
          <SolidColorBrush x:Key="EtsWarning" Color="#F0C36B" />
          <SolidColorBrush x:Key="EtsOk" Color="#79D2A2" />
          <SolidColorBrush x:Key="EtsDisabledBackground" Color="#2A2E33" />
          <SolidColorBrush x:Key="EtsDisabledText" Color="#949DA7" />

          <!-- Fluent disabled surfaces follow the palette instead of the theme's grey. -->
          <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#2A2E33" />
          <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#4A5158" />
          <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#949DA7" />
          <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#2A2E33" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#4A5158" />
          <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#949DA7" />

          <!-- Dock chrome mapped onto the Ets palette (dark). -->
          <Color x:Key="RegionColor">#25292E</Color>
          <SolidColorBrush x:Key="DockThemeBackgroundBrush" Color="#25292E" />
          <SolidColorBrush x:Key="DockThemeControlBackgroundBrush" Color="#25292E" />
          <SolidColorBrush x:Key="DockThemeBorderLowBrush" Color="#4A5158" />
          <SolidColorBrush x:Key="DockThemeForegroundBrush" Color="#F2F4F6" />
          <SolidColorBrush x:Key="DockThemeAccentBrush" Color="#62D1CD" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushLow" Color="#62D1CD" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushMed" Color="#85E0DC" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushHigh" Color="#233F43" />
          <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator" Color="#62D1CD" />
          <SolidColorBrush x:Key="DockApplicationAccentForegroundBrush" Color="#101418" />

          <!-- Tooltips are popup top-levels and do not inherit the window palette. -->
          <SolidColorBrush x:Key="ToolTipBackground" Color="#25292E" />
          <SolidColorBrush x:Key="ToolTipForeground" Color="#E5EBF3" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#4A5158" />
          <SolidColorBrush x:Key="TextControlForeground" Color="#E5EBF3" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Fluent's own accent (checkbox, progress bar, expander) follows the Ets palette. -->
    <FluentTheme>
      <FluentTheme.Palettes>
        <fluent:ColorPaletteResources x:Key="Light" Accent="#087E81" />
        <fluent:ColorPaletteResources x:Key="Dark" Accent="#62D1CD" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <DockFluentTheme />

    <!-- dock tabs follow the app's TabItem look instead of the Fluent defaults -->
    <Style Selector="DocumentTabStripItem">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="ToolTabStripItem">
      <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource EtsText}" />
      <Setter Property="Background" Value="{DynamicResource EtsChrome}" />
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="Background" Value="{DynamicResource ToolTipBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource ToolTipForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="ToolTip /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToolTipBackground}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource ToolTipForeground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToolTipBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,5" />
    </Style>
    <Style Selector="ToolTip TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ToolTipForeground}" />
    </Style>
    <Style Selector="ToolTip /template/ ContentPresenter TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ToolTipForeground}" />
    </Style>

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource EtsText}" />
    </Style>

    <!-- ===== buttons =====
         One geometry for every variant: ControlHeight, ControlPadding, ControlRadius and the
         same 2 px focus ring. Variants below change surface, border and text colour only.
         RepeatButton is excluded on purpose: ScrollBar and NumericUpDown spinner buttons derive
         from Button but must keep their own compact theme geometry. -->
    <Style Selector="Button:not(RepeatButton):not(ToggleButton)">
      <Setter Property="Foreground" Value="{DynamicResource EtsText}" />
      <Setter Property="Background" Value="{DynamicResource EtsButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
      <Setter Property="Height" Value="{StaticResource ControlHeight}" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button:not(RepeatButton):not(ToggleButton):pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EtsButtonHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsAccent}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource EtsText}" />
    </Style>
    <Style Selector="Button:not(RepeatButton):not(ToggleButton):pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EtsAccentSoft}" />
    </Style>
    <Style Selector="Button:not(RepeatButton):not(ToggleButton):focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource EtsAccent}" />
      <Setter Property="BorderThickness" Value="{StaticResource FocusRing}" />
    </Style>
    <Style Selector="Button:not(RepeatButton):not(ToggleButton):disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EtsDisabledBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsBorder}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource EtsDisabledText}" />
    </Style>
    <Style Selector="Button:not(RepeatButton):not(ToggleButton):disabled TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource EtsDisabledText}" />
    </Style>

    <!-- ribbon -->
    <Style Selector="Border.ribbon">
      <Setter Property="Background" Value="{DynamicResource EtsChrome}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsBorder}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Border.ribbonGroup">
      <Setter Property="BorderBrush" Value="{DynamicResource EtsBorder}" />
      <Setter Property="BorderThickness" Value="0,0,1,0" />
      <Setter Property="Padding" Value="2,0" />
    </Style>

    <!-- transparent command-bar action; same geometry as the default button -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource EtsText}" />
    </Style>
    <Style Selector="Button.tool:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource EtsDisabledText}" />
    </Style>

    <!-- secondary action: the default surface, named for explicit intent -->
    <Style Selector="Button.secondary">
      <Setter Property="Foreground" Value="{DynamicResource EtsText}" />
      <Setter Property="Background" Value="{DynamicResource EtsButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsBorder}" />
      <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
      <Setter Property="Height" Value="{StaticResource ControlHeight}" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>

    <!-- dense secondary action: only for monitor and toolbar rows -->
    <Style Selector="Button.compact">
      <Setter Property="Padding" Value="{StaticResource ControlPaddingCompact}" />
      <Setter Property="Height" Value="{StaticResource ControlHeightCompact}" />
    </Style>

    <!-- primary command: EtsAccent with a foreground that keeps AA contrast in both themes -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource EtsAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource EtsOnAccent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource EtsOnAccent}" />
    </Style>
    <Style Selector="Button.primary views|Icon">
      <Setter Property="Foreground" Value="{DynamicResource EtsOnAccent}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EtsAccentHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsAccentHover}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource EtsOnAccent}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EtsAccentHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsAccentHover}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource EtsOnAccent}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EtsDisabledBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsBorder}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource EtsDisabledText}" />
    </Style>
    <Style Selector="Button.primary:disabled TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource EtsDisabledText}" />
    </Style>
    <Style Selector="Button.primary:disabled views|Icon">
      <Setter Property="Foreground" Value="{DynamicResource EtsDisabledText}" />
    </Style>

    <!-- start screen cards: large keyboard-reachable buttons, not decoration -->
    <Style Selector="Button.card">
      <Setter Property="Background" Value="{DynamicResource EtsPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="18,16" />
      <Setter Property="Height" Value="NaN" />
      <Setter Property="MinHeight" Value="136" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EtsAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsAccent}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource EtsText}" />
    </Style>
    <Style Selector="Button.card:focus-visible /template/ ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource EtsAccent}" />
      <Setter Property="BorderThickness" Value="{StaticResource FocusRing}" />
    </Style>
    <Style Selector="Button.card views|Icon">
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- status bar -->
    <Style Selector="Border.statusBar">
      <Setter Property="Background" Value="{DynamicResource EtsStatusBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsBorder}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- panels -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource EtsPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsBorder}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.panelHeader">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Background" Value="{DynamicResource EtsHeaderRow}" />
      <Setter Property="Foreground" Value="{DynamicResource EtsText}" />
    </Style>
    <Style Selector="TextBlock.columnHeader">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource EtsMuted}" />
      <Setter Property="Padding" Value="6,3" />
    </Style>

    <!-- data rows -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Foreground" Value="{DynamicResource EtsText}" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Foreground" Value="{DynamicResource EtsText}" />
    </Style>

    <!-- selection: the Fluent accent purple clashes with EtsAccent, so selected rows use the
         blue family in both themes; keyboard focus keeps a visible EtsAccent ring. -->
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EtsAccentSoft}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource EtsText}" />
    </Style>
    <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource EtsAccent}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource EtsAccentSoft}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsAccentSoft}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource EtsText}" />
    </Style>
    <Style Selector="TreeViewItem:focus-visible /template/ Border#PART_LayoutRoot">
      <Setter Property="BorderBrush" Value="{DynamicResource EtsAccent}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EtsAccentSoft}" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource EtsText}" />
    </Style>
    <Style Selector="ComboBoxItem:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="BorderBrush" Value="{DynamicResource EtsAccent}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- icons: text colour by default, and the same 40% fade the review asks for when unavailable -->
    <Style Selector="PathIcon, views|Icon">
      <Setter Property="Foreground" Value="{DynamicResource EtsText}" />
    </Style>
    <!-- Icon sizes: controls 16, ribbon 20, cards 32; local Width/Height override these. -->
    <Style Selector="views|Icon">
      <Setter Property="Width" Value="{StaticResource IconSize}" />
      <Setter Property="Height" Value="{StaticResource IconSize}" />
    </Style>
    <Style Selector="Button views|Icon">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:disabled PathIcon, Button:disabled views|Icon, ListBoxItem:disabled PathIcon, ListBoxItem:disabled views|Icon, TreeViewItem:disabled PathIcon, TreeViewItem:disabled views|Icon, ComboBoxItem:disabled PathIcon, ComboBoxItem:disabled views|Icon">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource EtsMuted}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="TextBlock.kpi">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource EtsAccent}" />
    </Style>

    <!-- fields: same height, padding and radius as buttons so rows share one baseline -->
    <Style Selector="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource EtsText}" />
      <Setter Property="Background" Value="{DynamicResource EtsPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsBorder}" />
      <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
      <Setter Property="Height" Value="{StaticResource ControlHeight}" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource EtsAccent}" />
      <Setter Property="BorderThickness" Value="{StaticResource FocusRing}" />
    </Style>
    <!-- text field with a leading icon, e.g. the monitor filter -->
    <Style Selector="TextBox.search">
      <Setter Property="Padding" Value="28,4,6,4" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource EtsText}" />
      <Setter Property="Background" Value="{DynamicResource EtsPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsBorder}" />
      <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
      <Setter Property="Height" Value="{StaticResource ControlHeight}" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox:focus-visible /template/ Border#HighlightBackground">
      <Setter Property="BorderBrush" Value="{DynamicResource EtsAccent}" />
      <Setter Property="BorderThickness" Value="{StaticResource FocusRing}" />
    </Style>
    <Style Selector="NumericUpDown">
      <Setter Property="Foreground" Value="{DynamicResource EtsText}" />
      <Setter Property="Background" Value="{DynamicResource EtsPanel}" />
      <Setter Property="BorderBrush" Value="{DynamicResource EtsBorder}" />
      <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
      <Setter Property="Height" Value="{StaticResource ControlHeight}" />
      <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
      <Setter Property="CornerRadius" Value="{StaticResource ControlRadius}" />
    </Style>
    <!-- The inner editor of a spinner shares the outer control's box; keep the ring on the box. -->
    <Style Selector="NumericUpDown TextBox">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="NumericUpDown TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource EtsText}" />
    </Style>

    <!-- Dock tool chrome: 16 px buttons in a 29 px strip, an explicit exception to the tokens. -->
    <Style Selector="ToolChromeControl Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="ToolChromeControl Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource EtsAccentSoft}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="TextElement.Foreground" Value="{DynamicResource EtsText}" />
    </Style>
    <Style Selector="ToolChromeControl Path">
      <Setter Property="Fill" Value="{DynamicResource EtsMuted}" />
    </Style>
    <Style Selector="ToolChromeControl:active Path">
      <Setter Property="Fill" Value="{DynamicResource EtsOnAccent}" />
    </Style>
    <!-- Opt-in V4 resources/classes; not applied to legacy panels. -->
    <StyleInclude Source="avares://BusChord/Workbench/WorkbenchTheme.axaml" />
  </Application.Styles>
</Application>
